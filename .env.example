# Backend API base URL (no trailing slash). Default: http://localhost:8080/api
VITE_API_URL=http://localhost:8080/api

# Gemini: đặt GEMINI_API_KEY khi chạy backend (https://aistudio.google.com/app/apikey), không cần trong frontend.

# Spring Boot (set on the JVM / hosting env, not here): STORAGE_TYPE=r2, S3_ENDPOINT,
# S3_BUCKET, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, PUBLIC_ASSET_BASE_URL
